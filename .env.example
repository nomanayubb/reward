# ------------------------------------------------------------------
# Reward Platform - environment configuration
# Copy to .env and fill in real values. NEVER commit .env
# ------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Extra hosts / trusted origins (any host: VPS, Render, Railway, staging...)
EXTRA_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# Own-server deployment (docker-compose.prod.yml)
DOMAIN=yourdomain.com
POSTGRES_DB=reward
POSTGRES_USER=reward
POSTGRES_PASSWORD=change-me-postgres-password

# Database (PostgreSQL in production; sqlite fallback in development)
DATABASE_URL=postgres://reward:reward@localhost:5432/reward
# DATABASE_URL=sqlite:///db.sqlite3

# Redis (cache + celery broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Object storage (S3-compatible) - optional in development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Payments - NOWPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=True

# Payments - EasyPaisa (verify merchant/API availability before enabling)
EASYPAISA_API_KEY=
EASYPAISA_SECRET=
EASYPAISA_MERCHANT_ID=

# CPA / Offerwall providers (add one block per provider)
CPA_PROVIDER_A_KEY=
CPA_PROVIDER_A_SECRET=
CPA_PROVIDER_B_KEY=
CPA_PROVIDER_B_SECRET=

# Survey providers
SURVEY_PROVIDER_A_KEY=
SURVEY_PROVIDER_A_SECRET=

# Fraud / risk
IPQS_API_KEY=

# Security
SECURE_SSL_REDIRECT=False
